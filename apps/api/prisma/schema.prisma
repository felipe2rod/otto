// Esquema do banco do Otto. Regras (ADR 023, docs/mvp/backend.md seção 6):
// - toda tabela de negócio tem conta_id uuid NOT NULL; exceção só em prisma/isolamento.excecoes.ts;
// - filha referencia mãe por (id, conta_id);
// - a política de RLS de cada tabela é escrita à mão na MESMA migração que cria a tabela
//   (o Prisma não descreve política); o teste toda-tabela-tem-politica falha se faltar;
// - ids são UUID v7 gerados na aplicação, não no banco.

generator client {
  provider = "prisma-client"
  output   = "../src/plataforma/persistencia/gerado"
}

datasource db {
  provider = "postgresql"
}

enum AutoriaDoLote {
  designer
  agente

  @@map("autoria_do_lote")
}

enum TipoDeLote {
  edicao
  reversao

  @@map("tipo_de_lote")
}

enum EspecieDeArquivo {
  imagem
  vetor
  mascara

  @@map("especie_de_arquivo")
}

/// A conta: uma pessoa ou um estúdio (ADR 023, nota do pivô). Participa do RLS pela própria id.
model Conta {
  id       String   @id @db.Uuid
  nome     String
  interna  Boolean  @default(false)
  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  documentos Documento[]
  arquivos   Arquivo[]

  @@map("contas")
}

/// Metadado do documento e ponteiro para a versão atual. A árvore mora em versoes_de_documento.
model Documento {
  id              String    @id @db.Uuid
  contaId         String    @map("conta_id") @db.Uuid
  nome            String
  versaoAtual     Int       @default(0) @map("versao_atual")
  versaoDoFormato Int       @map("versao_do_formato")
  pranchetas      Int       @default(0)
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  alteradoEm      DateTime  @default(now()) @map("alterado_em") @db.Timestamptz(3)
  arquivadoEm     DateTime? @map("arquivado_em") @db.Timestamptz(3)
  /// Peça de exemplo semeada na conta nova.
  deExemplo       Boolean   @default(false) @map("de_exemplo")

  conta   Conta               @relation(fields: [contaId], references: [id])
  versoes     VersaoDeDocumento[]
  lotes       LoteDeOperacoes[]
  exportacoes Exportacao[]

  // alvo da chave estrangeira composta das filhas
  @@unique([id, contaId])
  // lista de documentos da conta, do mais recente para o mais antigo
  @@index([contaId, alteradoEm(sort: Desc)])
  @@map("documentos")
}

/// A árvore do documento em cada versão. No MVP, um snapshot por lote (a árvore mede de 7 a 18 KB).
/// `arvore` aceita nulo para o snapshot poder virar periódico sem migração.
model VersaoDeDocumento {
  contaId     String   @map("conta_id") @db.Uuid
  documentoId String   @map("documento_id") @db.Uuid
  versao      Int
  arvore      Json?
  bytes       Int
  criadaEm    DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  documento Documento @relation(fields: [documentoId, contaId], references: [id, contaId])

  // é a leitura de "abrir", de "ver o antes" e de desfazer: sempre por documento e versão
  @@id([documentoId, versao])
  @@map("versoes_de_documento")
}

/// O histórico único (ADR 027): cada lote com autoria e versão resultante. Só acréscimo:
/// desfazer grava um lote de reversão e marca `desfeitoPor`; nenhuma linha é apagada.
model LoteDeOperacoes {
  id               String        @id @db.Uuid
  contaId          String        @map("conta_id") @db.Uuid
  documentoId      String        @map("documento_id") @db.Uuid
  versao           Int
  autoria          AutoriaDoLote
  /// id da tarefa do agente; a tabela de tarefas e a chave estrangeira entram na fatia do agente
  tarefaId         String?       @map("tarefa_id") @db.Uuid
  tipo             TipoDeLote    @default(edicao)
  reverteAteVersao Int?          @map("reverte_ate_versao")
  desfeitoPor      String?       @map("desfeito_por") @db.Uuid
  descricao        String
  operacoes        Json
  /** Guardado à parte para o histórico não precisar carregar as operações (um vetor pesa MB). */
  quantidadeDeOperacoes Int      @default(0) @map("quantidade_de_operacoes")
  tocados          Json
  /// id gerado pelo editor: reenviar o mesmo lote não aplica duas vezes
  chaveDoCliente   String?       @map("chave_do_cliente") @db.Uuid
  criadoEm         DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)

  documento Documento @relation(fields: [documentoId, contaId], references: [id, contaId])

  // dois lotes não ocupam a mesma versão, mesmo com defeito na aplicação; e serve o histórico por documento
  @@unique([documentoId, versao])
  // reenvio do mesmo lote pelo editor
  @@unique([contaId, documentoId, chaveDoCliente])
  // os lotes de um conjunto de alterações do agente
  @@index([contaId, tarefaId])
  @@map("lotes_de_operacoes")
}

/// Imagem, vetor ou máscara da conta, por hash de conteúdo (ADR 027). A linha é a autorização;
/// o hash não é. `chaveDoObjeto` nunca vem do cliente e nunca volta para ele.
model Arquivo {
  id              String           @id @db.Uuid
  contaId         String           @map("conta_id") @db.Uuid
  sha256          String           @db.Char(64)
  tipoMime        String           @map("tipo_mime")
  bytes           Int
  largura         Int?
  altura          Int?
  especie         EspecieDeArquivo
  origemBanco     String?          @map("origem_banco")
  origemIdExterno String?          @map("origem_id_externo")
  origemAutor     String?          @map("origem_autor")
  origemLicenca   String?          @map("origem_licenca")
  origemUrl       String?          @map("origem_url")
  nomeOriginal    String?          @map("nome_original")
  chaveDoObjeto   String           @map("chave_do_objeto")
  criadoEm        DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)

  conta Conta @relation(fields: [contaId], references: [id])

  // é a busca de toda leitura de arquivo: conta e hash
  @@unique([contaId, sha256])
  @@map("arquivos")
}

/// Fontes do Otto: iguais para todas as contas (licença aberta). Catálogo global, sem conta_id:
/// exceção declarada em isolamento.excecoes.ts. Fonte enviada pela conta, quando existir, é outra tabela.
model FonteDaBiblioteca {
  id             String   @id @db.Uuid
  familia        String
  peso           Int
  nomePostScript String?  @map("nome_postscript")
  sha256         String   @db.Char(64)
  bytes          Int
  chaveDoObjeto  String   @map("chave_do_objeto")
  licenca        String?
  criadaEm       DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  // é a busca do editor e do medidor: família e peso
  @@unique([familia, peso])
  @@map("fontes_da_biblioteca")
}

enum FormatoDeExportacao {
  psd
  png
  svg
  pdf

  @@map("formato_de_exportacao")
}

enum EstadoDaExportacao {
  na_fila
  rodando
  pronta
  pronta_em_parte
  falhou

  @@map("estado_da_exportacao")
}

/// Um pedido de exportação e o seu andamento. É da VERSÃO do documento no momento do pedido.
/// O relatório cita nome de camada: é conteúdo, fica sob RLS e nunca vai para log (ADR 031).
model Exportacao {
  id                String              @id @db.Uuid
  contaId           String              @map("conta_id") @db.Uuid
  documentoId       String              @map("documento_id") @db.Uuid
  versao            Int
  /// nome do documento no momento do pedido: vira nome de arquivo
  nome              String
  formato           FormatoDeExportacao
  /// { arquivos?, pranchetas, escala?, semFundo? }: o pedido, com as pranchetas já resolvidas em ids
  opcoes            Json
  estado            EstadoDaExportacao  @default(na_fila)
  pranchetasNoTotal Int                 @map("pranchetas_no_total")
  pranchetasProntas Int                 @default(0) @map("pranchetas_prontas")
  /// [{ pranchetaId, codigo }]: o que não saiu, quando o resultado é parcial
  falhas            Json                @default("[]")
  relatorio         Json?
  erroCodigo        String?             @map("erro_codigo")
  duracaoMs         Int?                @map("duracao_ms")
  /// sinal de vida do worker: exportação "rodando" sem sinal há minutos é dada como interrompida
  batimentoEm       DateTime?           @map("batimento_em") @db.Timestamptz(3)
  criadaEm          DateTime            @default(now()) @map("criada_em") @db.Timestamptz(3)
  iniciadaEm        DateTime?           @map("iniciada_em") @db.Timestamptz(3)
  terminadaEm       DateTime?           @map("terminada_em") @db.Timestamptz(3)
  /// quando os arquivos podem ser apagados (7 dias depois de prontos)
  expiraEm          DateTime?           @map("expira_em") @db.Timestamptz(3)
  /// quantas vezes começou a rodar (2 = retomada depois de um worker morrer)
  tentativas        Int                 @default(0)
  /// quando os arquivos foram apagados do armazenamento (a linha fica)
  arquivosRemovidosEm DateTime?         @map("arquivos_removidos_em") @db.Timestamptz(3)

  documento Documento             @relation(fields: [documentoId, contaId], references: [id, contaId])
  arquivos  ArquivoDeExportacao[]

  // alvo da chave estrangeira composta dos arquivos
  @@unique([id, contaId])
  // quantas a conta tem na fila ou rodando; a mais recente de um documento
  @@index([contaId, estado])
  @@index([contaId, documentoId, criadaEm(sort: Desc)])
  @@map("exportacoes")
}

/// Cada arquivo que uma exportação gerou. `chaveDoObjeto` nunca vai ao cliente: o download é por link assinado.
model ArquivoDeExportacao {
  contaId       String   @map("conta_id") @db.Uuid
  exportacaoId  String   @map("exportacao_id") @db.Uuid
  indice        Int
  nome          String
  tipoMime      String   @map("tipo_mime")
  bytes         Int
  pranchetaId   String?  @map("prancheta_id")
  chaveDoObjeto String   @map("chave_do_objeto")
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  exportacao Exportacao @relation(fields: [exportacaoId, contaId], references: [id, contaId])

  // é a leitura do download: exportação e índice
  @@id([exportacaoId, indice])
  @@map("arquivos_de_exportacao")
}

enum EstadoDaTarefa {
  na_fila
  preparando
  aguardando_confirmacao
  rodando
  em_revisao
  aceita
  desfeita
  cancelada
  falhou

  @@map("estado_da_tarefa")
}

enum EstadoDaPendencia {
  aberta
  resolvida
  dispensada

  @@map("estado_da_pendencia")
}

/// A tarefa do Otto (ADR 029) e o custo total dela. Uma viva por peça e uma trabalhando por conta:
/// os dois índices únicos parciais estão na migração.
model TarefaDoAgente {
  id                    String         @id @db.Uuid
  contaId               String         @map("conta_id") @db.Uuid
  documentoId           String         @map("documento_id") @db.Uuid
  tipo                  String
  esforco               String?
  estado                EstadoDaTarefa @default(na_fila)
  fase                  String         @default("preparo")
  fim                   String?
  erroCodigo            String?        @map("erro_codigo")
  etapa                 Json?
  etapas                Json           @default("[]")
  preparo               Json?
  aprovadaEm            DateTime?      @map("aprovada_em") @db.Timestamptz(3)
  versaoInicial         Int            @map("versao_inicial")
  versaoFinal           Int?           @map("versao_final")
  lotes                 Int            @default(0)
  tocados               Json           @default("[]")
  entrega               Json?
  conferida             Boolean?
  modelo                String?
  chamadas              Int            @default(0)
  tokensDeEntrada       BigInt         @default(0) @map("tokens_de_entrada")
  tokensDeCacheLidos    BigInt         @default(0) @map("tokens_de_cache_lidos")
  tokensDeCacheCriados  BigInt         @default(0) @map("tokens_de_cache_criados")
  tokensDeSaida         BigInt         @default(0) @map("tokens_de_saida")
  imagensEnviadas       Int            @default(0) @map("imagens_enviadas")
  voltasDeConferencia   Int            @default(0) @map("voltas_de_conferencia")
  lotesRecusados        Int            @default(0) @map("lotes_recusados")
  duracaoMs             Int            @default(0) @map("duracao_ms")
  custoEstimadoMicroUsd BigInt?        @map("custo_estimado_micro_usd")
  resultado             String?
  idsDoPreparo          Int            @default(0) @map("ids_do_preparo")
  ultimoEvento          Int            @default(-1) @map("ultimo_evento")
  origemId              String?        @map("origem_id") @db.Uuid
  /// O briefing salvo de onde o formulário partiu. Apagado o briefing, vira nulo.
  briefingId            String?        @map("briefing_id") @db.Uuid
  /// Quando entrou (ou voltou) para a fila.
  enfileiradaEm         DateTime       @default(now()) @map("enfileirada_em") @db.Timestamptz(3)
  cancelamentoPedidoEm  DateTime?      @map("cancelamento_pedido_em") @db.Timestamptz(3)
  batimentoEm           DateTime?      @map("batimento_em") @db.Timestamptz(3)
  criadaEm              DateTime       @default(now()) @map("criada_em") @db.Timestamptz(3)
  iniciadaEm            DateTime?      @map("iniciada_em") @db.Timestamptz(3)
  terminadaEm           DateTime?      @map("terminada_em") @db.Timestamptz(3)
  decididaEm            DateTime?      @map("decidida_em") @db.Timestamptz(3)

  @@unique([id, contaId])
  @@index([contaId, documentoId, criadaEm(sort: Desc)])
  @@index([contaId, criadaEm(sort: Desc)])
  @@map("tarefas_do_agente")
}

/// O pedido ou o briefing preenchido. Separada de propósito: é o único texto que a equipe pode ler (ADR 031, item 2).
model EntradaDeTarefa {
  tarefaId String   @id @map("tarefa_id") @db.Uuid
  contaId  String   @map("conta_id") @db.Uuid
  entrada  Json
  ajustes  Json     @default("[]")
  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  @@map("entradas_de_tarefa")
}

/// A linha do tempo que o designer vê. A sequência é o id do fluxo de eventos e o ponto de retomada.
model EventoDeTarefa {
  tarefaId  String   @map("tarefa_id") @db.Uuid
  sequencia Int
  contaId   String   @map("conta_id") @db.Uuid
  tipo      String
  dados     Json
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@id([tarefaId, sequencia])
  @@map("eventos_de_tarefa")
}

/// Custo por chamada ao modelo (ADR 029, item 5). Gravada a cada chamada, inclusive a que falha.
model ChamadaAoModelo {
  tarefaId             String   @map("tarefa_id") @db.Uuid
  sequencia            Int
  contaId              String   @map("conta_id") @db.Uuid
  papel                String
  modelo               String
  tokensDeEntrada      Int      @map("tokens_de_entrada")
  tokensDeCacheLidos   Int      @map("tokens_de_cache_lidos")
  tokensDeCacheCriados Int      @map("tokens_de_cache_criados")
  tokensDeSaida        Int      @map("tokens_de_saida")
  imagens              Int
  duracaoMs            Int      @map("duracao_ms")
  resultado            String
  criadaEm             DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  @@id([tarefaId, sequencia])
  @@map("chamadas_ao_modelo")
}

/// Pendência da peça: o que o Otto disse que não resolveu, com estado. Sobrevive ao aceite.
model Pendencia {
  id          String            @id @db.Uuid
  contaId     String            @map("conta_id") @db.Uuid
  documentoId String            @map("documento_id") @db.Uuid
  tarefaId    String            @map("tarefa_id") @db.Uuid
  tipo        String
  texto       String
  camadas     Json              @default("[]")
  prancheta   String?
  origem      String
  regra       String?
  gravidade   String?
  estado      EstadoDaPendencia @default(aberta)
  criadaEm    DateTime          @default(now()) @map("criada_em") @db.Timestamptz(3)
  fechadaEm   DateTime?         @map("fechada_em") @db.Timestamptz(3)

  @@index([contaId, documentoId, estado])
  @@index([contaId, tarefaId])
  @@map("pendencias")
}

/// Contador da plataforma (o limite diário do fornecedor é um só para todas as contas). Sem conta_id:
/// exceção declarada em isolamento.excecoes.ts. Só números e data.
model ConsumoDiarioDoModelo {
  dia                  DateTime  @id @db.Date
  tokens               BigInt    @default(0)
  chamadas             Int       @default(0)
  restanteNoFornecedor BigInt?   @map("restante_no_fornecedor")
  vistoEm              DateTime? @map("visto_em") @db.Timestamptz(3)

  @@map("consumo_diario_do_modelo")
}

/// Identidade de um cliente do designer (docs/mvp/experiencia.md, 3.3). Conteúdo da conta.
model Marca {
  id            String   @id @db.Uuid
  contaId       String   @map("conta_id") @db.Uuid
  nome          String
  site          String?
  cores         Json     @default("{}")
  fonteDeTitulo String?  @map("fonte_de_titulo")
  fonteDeTexto  String?  @map("fonte_de_texto")
  logoSha256    String?  @map("logo_sha256") @db.Char(64)
  icones        Json     @default("[]")
  rodape        String?
  restricoes    Json     @default("[]")
  criadaEm      DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)
  alteradaEm    DateTime @default(now()) @map("alterada_em") @db.Timestamptz(3)

  @@unique([id, contaId])
  // a lista de marcas da conta, por nome
  @@index([contaId, nome])
  @@map("marcas")
}

/// Formulário de briefing pela metade, reutilizável (ADR 033).
model Briefing {
  id         String   @id @db.Uuid
  contaId    String   @map("conta_id") @db.Uuid
  nome       String
  marcaId    String?  @map("marca_id") @db.Uuid
  dados      Json
  cuidado    String?
  usos       Int      @default(0)
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  alteradoEm DateTime @default(now()) @map("alterado_em") @db.Timestamptz(3)

  @@unique([id, contaId])
  // a lista de briefings da conta, do alterado mais recentemente para o mais antigo
  @@index([contaId, alteradoEm(sort: Desc)])
  @@map("briefings")
}

/// Cache de 24 h das buscas no banco de imagens (ADR 032). Da plataforma, sem conta_id: exceção declarada
/// em isolamento.excecoes.ts. Não guarda o texto da busca.
model BuscaDeImagens {
  banco      String
  chave      String   @db.Char(64)
  buscadaEm  DateTime @default(now()) @map("buscada_em") @db.Timestamptz(3)
  resultados Json

  @@id([banco, chave, buscadaEm])
  @@map("buscas_de_imagens")
}

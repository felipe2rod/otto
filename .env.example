# Copie para .env SÓ se quiser trocar algum padrão. O `docker compose up` funciona sem este arquivo:
# os padrões de desenvolvimento estão no compose.yaml. O .env nunca vai para o git.
# Segredo de verdade (chave de modelo, de banco de imagens) entra aqui a partir da fatia que usa.

# Porta da borda no host (página e API na mesma origem). Ocupadas: 80, 3030, 3306, 5433, 7070, 8137.
PORTA_DA_BORDA=8080

# Quantos workers sobem e quantas exportações cada um roda ao mesmo tempo (uma thread e um núcleo para cada).
WORKERS=2
EXPORTACOES_POR_WORKER=2

# Porta do armazenamento no host: é para onde aponta o link assinado de download de exportação.
PORTA_DO_ARMAZENAMENTO=8081

# Senhas dos papéis do banco de desenvolvimento (ADR 023). Valem na CRIAÇÃO do volume do banco:
# para trocar depois, apague o volume (docker compose down, docker volume rm otto_dados_do_banco).
BANCO_SENHA_SUPERUSUARIO=superusuario-dev
BANCO_SENHA_MIGRADOR=migrador-dev
BANCO_SENHA_APP=app-dev
BANCO_SENHA_OPERACAO=operacao-dev

# Credencial do armazenamento compatível com S3 do desenvolvimento.
ARMAZENAMENTO_CHAVE_DE_ACESSO=otto-dev
ARMAZENAMENTO_CHAVE_SECRETA=segredo-do-armazenamento-dev

# fatal, error, warn, info, debug, trace ou silent
NIVEL_DE_LOG=info

# ---- a tarefa do Otto (só o worker lê o modelo e a chave) ----
# roteirizado: reproduz uma tarefa gravada, sem falar com modelo e sem custo (padrão fora de produção).
# claude: o modelo de verdade, na inferência da DigitalOcean. Cada tarefa custa (docs/tecnico/custos.md).
MODELO_DO_AGENTE=roteirizado
# Chave da inferência. Só é exigida com MODELO_DO_AGENTE=claude. Nunca entra no repositório.
LLM_API_KEY_DO=
# Vazio: o modelo padrão do adaptador (Sonnet 5).
MODELO_NOME=
# 1: o roteiro demora o que demorou na gravação. 0: responde na hora.
VELOCIDADE_DO_ROTEIRO=0.05
TAREFAS_POR_WORKER=2
# Limites operacionais, não plano comercial.
# No desenvolvimento, folgado (os testes de navegador pedem 5 tarefas por execução). Em produção: 30, o padrão do código.
TAREFAS_POR_DIA_POR_CONTA=1000
TAREFAS_NA_FILA_POR_CONTA=3
# Alavancas de custo do ciclo do Otto: nenhuma, todas, ou números de 1 a 4 separados por vírgula (ver docs/tecnico/custos.md, seção 10).
ALAVANCAS_DE_CUSTO=nenhuma
# Teto nosso de tokens por dia, da plataforma inteira (o do fornecedor medido em 2026-10-02 é de 45 milhões).
TETO_DIARIO_DE_TOKENS=40000000

# ---- banco de imagens e fontes (fatia 4) ----
# Chave do banco de imagens de fábrica (ADR 032). Segredo: nunca entra no repositório.
# Vazia: a busca de imagens responde 503 e o Otto fica sem as ferramentas de imagem.
PIXABAY_API_KEY=
IMAGENS_TRAZIDAS_POR_DIA_POR_CONTA=100
# google: a biblioteca traz do Google Fonts a família que ainda não tem, na primeira vez. nenhum: só as fontes semeadas.
CATALOGO_DE_FONTES=google

# Importação de PSD. Teto do arquivo enviado, em bytes (padrão 100 MB; o pacote de PSD aguenta até 300 MB, mas a
# API recebe o arquivo inteiro em memória), e tetos de pixel: a maior camada e a soma de todas, em milhões de pixels.
PSD_BYTES_MAXIMOS=104857600
PSD_MEGAPIXELS_POR_CAMADA=40
PSD_MEGAPIXELS_DE_TODAS_AS_CAMADAS=200

{
  "name": "otto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Otto: editor de design em camadas operado por agente próprio (monorepo do MVP, ADR 035)",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:fronteira": "vitest run --project fronteira",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
